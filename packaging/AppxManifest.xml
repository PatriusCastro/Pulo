<?xml version="1.0" encoding="utf-8"?>
<!-- Local test MSIX. Gives Pulo package identity, which reading Windows notifications
     requires. Version 0.0.0.0 is replaced by scripts/msix.ps1 from package.json. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">
  <Identity Name="Pulo.Dev" Publisher="CN=Pulo Dev" Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Pulo (dev)</DisplayName>
    <PublisherDisplayName>Pulo</PublisherDisplayName>
    <Logo>icons\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Pulo" Executable="pulo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Pulo (dev)"
        Description="A Dynamic Island for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="icons\Square150x150Logo.png"
        Square44x44Logo="icons\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
    <DeviceCapability Name="bluetooth" /> <!-- device battery levels -->
  </Capabilities>
</Package>
